        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "pg-prometheus"
          },
          "expr": "sum by(stage) (rate(pg_worker_attempt_failures_total{instance=~\"$worker\"}[$__rate_interval]))",
          "legendFormat": "Попытки · {{stage}}",
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
