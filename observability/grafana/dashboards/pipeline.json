      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "DLQ",
      "description": "Глубина DLQ из RabbitMQ. В случае устойчивой ошибки каждая задача после исчерпания попыток увеличивает глубину.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "pg-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "pg-prometheus"
          },
          "expr": "rabbitmq_detailed_queue_messages_ready{queue=~\"$queue[.]dlq\"}",
          "legendFormat": "Глубина DLQ",
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: сообщ.",
          "min": 0,
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 2
