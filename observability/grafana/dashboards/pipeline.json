    {
      "id": 10,
      "title": "Ошибки и повторные доставки",
      "description": "Отдельные ряды для ошибок попыток, итогов задач и повторных доставок RabbitMQ.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "pg-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "pg-prometheus"
          },
          "expr": "sum by(result) (rate(pg_worker_tasks_total{result=~\"error|dlq\",instance=~\"$worker\"}[$__rate_interval]))",
          "legendFormat": "{{result}}",
          "exemplar": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "pg-prometheus"
          },
          "expr": "sum(rate(pg_worker_redeliveries_total{instance=~\"$worker\"}[$__rate_interval]))",
          "legendFormat": "Redelivery",
