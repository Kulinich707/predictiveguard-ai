    {
      "id": 14,
      "title": "SLO · 99% задач за 60 с",
      "description": "Доля успехов за 60 с среди завершённых задач за 5 минут. Ошибочные итоги и DLQ считаются промахами.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "pg-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "pg-prometheus"
          },
          "expr": "sum(rate(pg_worker_task_latency_seconds_bucket{le=\"60.0\",instance=~\"$worker\"}[5m])) / (sum(rate(pg_worker_tasks_total{instance=~\"$worker\"}[5m])) > 0)",
          "legendFormat": "Доля в SLO",
          "exemplar": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "pg-prometheus"
          },
          "expr": "vector(0.99)",
          "legendFormat": "Цель 99%",
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
